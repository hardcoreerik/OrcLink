{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrcLink Control Room",
  "version": "0.1.0",
  "identifier": "local.orclink.control-room",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "OrcLink Control Room",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:4017; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
